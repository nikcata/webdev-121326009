    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/services/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=80"
  },
